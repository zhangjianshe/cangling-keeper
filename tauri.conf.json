{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cangling-keeper",
  "version": "0.0.26",
  "identifier": "cn.cangling.keeper",
  "build": {
    "beforeDevCommand": null,
    "beforeBuildCommand": null,
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "维护中心",
        "width": 900,
        "height": 650,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
